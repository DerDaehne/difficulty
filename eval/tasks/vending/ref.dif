use std.io

struct Machine {
    int credit = 0
    int strikes = 0
    bool locked = false
}

// Price in cents, none for an unknown item.
?int price(str item) {
    switch item {
    case "A":
        return 60
    case "B":
        return 120
    case "C":
        return 150
    default:
        return none
    }
}

// The value of an accepted coin, none for anything else.
?int coin_value(str text) {
    switch text {
    case "10", "20", "50", "100":
        return text.parse_int()
    default:
        return none
    }
}

void bad_command() {
    print("error: bad command")
}

// False, after the error message, while the machine is locked.
bool Machine.open() {
    if self.locked {
        print("error: locked")
    }
    return !self.locked
}

void Machine.coin(mut self, str text) {
    switch coin_value(text) {
    case some(int value):
        self.credit += value
        print("credit {self.credit}")
    case none:
        print("rejected")
        self.strikes += 1
        if self.strikes == 3 {
            print("locked")
            self.locked = true
        }
    }
}

void Machine.select(mut self, str item) {
    switch price(item) {
    case some(int cost):
        if self.credit < cost {
            print("error: need {cost - self.credit} more")
        } else {
            print("vend {item} change {self.credit - cost}")
            self.credit = 0
        }
    case none:
        print("error: unknown item {item}")
    }
}

void Machine.refund(mut self) {
    print("refund {self.credit}")
    self.credit = 0
}

void Machine.unlock(mut self) {
    if self.locked {
        self.locked = false
        self.strikes = 0
        print("unlocked")
    } else {
        print("error: not locked")
    }
}

void Machine.status() {
    str state = if self.locked { "locked" } else if self.credit > 0 { "active" } else { "idle" }
    print("state {state} credit {self.credit}")
}

// One command line: the words, the first is the command.
void Machine.command(mut self, []str words) {
    int args = words.len() - 1
    switch words[0] {
    case "coin":
        if args != 1 {
            bad_command()
        } else if self.open() {
            self.coin(words[1])
        }
    case "select":
        if args != 1 {
            bad_command()
        } else if self.open() {
            self.select(words[1])
        }
    case "refund":
        if args != 0 {
            bad_command()
        } else if self.open() {
            self.refund()
        }
    case "unlock":
        if args != 0 {
            bad_command()
        } else {
            self.unlock()
        }
    case "status":
        if args != 0 {
            bad_command()
        } else {
            self.status()
        }
    default:
        bad_command()
    }
}

void!io.IoErr main() {
    Machine m = Machine{}
    for str raw in try io.lines() {
        str line = raw.trim()
        if !line.is_empty() {
            m.command(line.split(" "))
        }
    }
}
