use std.io

enum CalcErr {
    Syntax(int col)
    DivByZero
}

enum Expr {
    Num(int value)
    Neg(Expr operand)
    Op(rune op, Expr left, Expr right)
}

struct Parser {
    []rune chars
    int pos = 0
}

// The next character after spaces, '\0' at the end of the line.
rune Parser.peek(mut self) {
    while self.pos < self.chars.len() && self.chars[self.pos] == ' ' {
        self.pos += 1
    }
    if self.pos == self.chars.len() {
        return '\0'
    }
    return self.chars[self.pos]
}

Expr!CalcErr Parser.fail(mut self) {
    _ = self.peek()
    return err(CalcErr.Syntax(self.pos + 1))
}

Expr!CalcErr Parser.number(mut self) {
    int value = 0
    while self.pos < self.chars.len() && self.chars[self.pos].is_digit() {
        value = value * 10 + (self.chars[self.pos].to_digit() ?? 0)
        self.pos += 1
    }
    return Expr.Num(value)
}

Expr!CalcErr Parser.unary(mut self) {
    rune c = self.peek()
    if c == '-' {
        self.pos += 1
        return Expr.Neg(try self.unary())
    }
    if c == '(' {
        self.pos += 1
        Expr inner = try self.expr()
        if self.peek() != ')' {
            return self.fail()
        }
        self.pos += 1
        return inner
    }
    if c.is_digit() {
        return self.number()
    }
    return self.fail()
}

Expr!CalcErr Parser.term(mut self) {
    Expr left = try self.unary()
    while true {
        rune op = self.peek()
        if op != '*' && op != '/' && op != '%' {
            return left
        }
        self.pos += 1
        left = Expr.Op(op, left, try self.unary())
    }
}

Expr!CalcErr Parser.expr(mut self) {
    Expr left = try self.term()
    while true {
        rune op = self.peek()
        if op != '+' && op != '-' {
            return left
        }
        self.pos += 1
        left = Expr.Op(op, left, try self.term())
    }
}

Expr!CalcErr parse(str line) {
    Parser p = Parser{chars: line.runes()}
    Expr e = try p.expr()
    if p.peek() != '\0' {
        return err(CalcErr.Syntax(p.pos + 1))
    }
    return e
}

int!CalcErr eval(Expr e) {
    switch e {
    case Expr.Num(int value):
        return value
    case Expr.Neg(Expr operand):
        return -(try eval(operand))
    case Expr.Op(rune op, Expr left, Expr right):
        int a = try eval(left)
        int b = try eval(right)
        switch op {
        case '+':
            return a + b
        case '-':
            return a - b
        case '*':
            return a * b
        default:
            if b == 0 {
                return err(CalcErr.DivByZero)
            }
            return if op == '/' { a / b } else { a % b }
        }
    }
}

int!CalcErr calc(str line) {
    return eval(try parse(line))
}

str message(CalcErr e) {
    switch e {
    case CalcErr.Syntax(int col):
        return "error: syntax at {col}"
    case CalcErr.DivByZero:
        return "error: division by zero"
    }
}

void!io.IoErr main() {
    for str line in try io.lines() {
        if line.trim().is_empty() {
            continue
        }
        switch calc(line) {
        case ok(int value):
            print(value)
        case err(CalcErr e):
            print(message(e))
        }
    }
}
