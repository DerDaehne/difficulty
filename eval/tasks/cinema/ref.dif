use std.io

const int ROWS = 5
const int SEATS = 8

struct Hall {
    []bool taken = repeat(false, ROWS * SEATS)
}

bool Hall.is_taken(int row, int seat) {
    return self.taken[row * SEATS + seat]
}

void Hall.set(mut self, int row, int seat, bool value) {
    self.taken[row * SEATS + seat] = value
}

int Hall.sold() {
    return self.taken.count(true)
}

// The first position in `row` where `n` seats in a row are free.
?int Hall.free_block(int row, int n) {
    for int start in range(SEATS - n + 1) {
        bool free = true
        for int k in range(n) {
            if self.is_taken(row, start + k) {
                free = false
            }
        }
        if free {
            return start
        }
    }
    return none
}

str Hall.plan() {
    str text = "  12345678"
    for int row in range(ROWS) {
        text += "\n{row + 1} "
        for int seat in range(SEATS) {
            text += if self.is_taken(row, seat) { "X" } else { "." }
        }
    }
    return text
}

// All words as numbers, or none if one of them is not a decimal integer.
?[]int numbers([]str words) {
    []int values = []
    for str w in words {
        values.push(try w.parse_int())
    }
    return values
}

bool is_seat(int row, int seat) {
    return row >= 1 && row <= ROWS && seat >= 1 && seat <= SEATS
}

void Hall.book(mut self, int row, int seat) {
    if !is_seat(row, seat) {
        print("error: no such seat {row} {seat}")
    } else if self.is_taken(row - 1, seat - 1) {
        print("error: seat {row} {seat} is taken")
    } else {
        self.set(row - 1, seat - 1, true)
        print("booked {row} {seat}")
    }
}

void Hall.cancel(mut self, int row, int seat) {
    if !is_seat(row, seat) {
        print("error: no such seat {row} {seat}")
    } else if !self.is_taken(row - 1, seat - 1) {
        print("error: seat {row} {seat} is not booked")
    } else {
        self.set(row - 1, seat - 1, false)
        print("cancelled {row} {seat}")
    }
}

void Hall.book_group(mut self, int n) {
    if n < 1 || n > SEATS {
        print("error: bad group size {n}")
        return
    }
    for int row in range(ROWS) {
        switch self.free_block(row, n) {
        case some(int start):
            for int k in range(n) {
                self.set(row, start + k, true)
            }
            print("group {n} booked: row {row + 1}, seats {start + 1} to {start + n}")
            return
        case none:
        }
    }
    print("error: no block of {n} free seats")
}

void Hall.total() {
    int sold = self.sold()
    print("sold {sold} of {ROWS * SEATS}, occupancy {f64(sold) * 100.0 / f64(ROWS * SEATS):.1f}%")
}

// A command with its arguments, already known to be numbers.
void Hall.command(mut self, str cmd, []int args) {
    int n = args.len()
    if cmd == "b" && n == 2 {
        self.book(args[0], args[1])
    } else if cmd == "s" && n == 2 {
        self.cancel(args[0], args[1])
    } else if cmd == "g" && n == 1 {
        self.book_group(args[0])
    } else if cmd == "p" && n == 0 {
        print(self.plan())
    } else if cmd == "t" && n == 0 {
        self.total()
    } else {
        print("error: bad command")
    }
}

void!io.IoErr main() {
    Hall hall = Hall{}
    for str raw in try io.lines() {
        str line = raw.trim()
        if line.is_empty() {
            continue
        }
        []str words = line.split(" ")
        if words == ["q"] {
            break
        }
        switch numbers(words.slice(1, words.len())) {
        case some([]int args):
            hall.command(words[0], args)
        case none:
            print("error: bad command")
        }
    }
}
