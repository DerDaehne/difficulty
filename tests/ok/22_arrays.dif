const int N = 3

struct Grid {
    [N][N]int cells
    [2]str names = ["a", "b"]
}

void bump(mut int x) {
    x += 1
}

int total([N]int row) {
    int t = 0
    for int v in row {
        t += v
    }
    return t
}

void main() {
    [3]int a = [3, 1, 2]
    [3]int b = a
    b[0] = 9
    print(a)
    print(b)
    print(a == b)
    print(a.len())
    print(a.is_empty())
    print(a.first())
    print(a.last())
    print(a.contains(2))
    print(a.index_of(2))
    print(a.count(1))
    print(a.slice(1, 3))
    a.sort()
    print(a)
    a.reverse()
    print(a)
    [2]str s = ["y", "x"]
    s.sort()
    print(s)
    print(s.join("+"))
    bump(mut a[1])
    print(a)
    print(total(a))

    Grid g = Grid{cells: [[1, 2, 3], [4, 5, 6], [7, 8, 9]]}
    g.cells[1][2] = 60
    g.cells[2].reverse()
    print(g)
    Grid h = g
    h.names[0] = "changed"
    h.cells[0][0] = -1
    print(g.names)
    print(h.names)
    print(g.cells[0])
    print(h.cells[0])
    print(g == h)
    for int i, [N]int row in g.cells {
        print("{i}: {total(row)}")
    }
    [2][2]int m = [[1, 2], [3, 4]]
    for [2]int row in m {
        m[0][0] += 10
        print(row)
    }
    print(m)
    []Grid gs = [g]
    gs[0].cells[0][1] = 5
    print(gs[0].cells[0])
    print(g.cells[0])
}
