void main() {
    int n = 7
    print("[{n:02}] [{-5:04}] [{n:>5}] [{n:<5}] [{n:5}]")
    str s = "äö"
    print("[{s:5}] [{s:>5}] [{s:<5}] [{s:1}]")
    f64 x = 3.14159
    print("[{x:8.2f}] [{x:08.2f}] [{-x:08.2f}] [{x:<9.1f}] [{x:g}] [{x:10g}]")
    print("[{true:>6}] [{'x':3}] [{n:>05}]")
    print("{'7'.to_digit()} {'a'.to_digit()} {'٣'.to_digit()}")
}
