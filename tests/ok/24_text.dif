str shout(str s) {
    return s.upper() + "!"
}

void main() {
    str s = "  Hallo, Welt  "
    print("[{s.trim()}]")
    print("[{s.trim_start()}]")
    print("[{s.trim_end()}]")
    print(s.len())
    print(s.is_empty())
    print("".is_empty())
    print("äö".len())
    print("äö".runes())
    print("äö".runes().len())
    print("a,b,,c".split(","))
    print("".split(","))
    print("abc".split("abc"))
    print("a--b".split("--"))
    print("a\nb\n".lines())
    print("a\r\nb\r\n\r\nc".lines())
    print("x\r".lines())
    print("".lines())
    print("\n".lines())
    print("Hallo".slice(1, 3))
    print("Hallo".slice(2, 2))
    print("äö".slice(2, 4))
    print("Hallo".find("ll"))
    print("Hallo".find(""))
    print("x".find("y"))
    print("Hallo".contains("all"))
    print("Hallo".contains(""))
    print("Hallo".starts_with("Ha"))
    print("Hallo".ends_with("lo"))
    print("Hallo".ends_with("Hallo!"))
    print("a-b-c".replace("-", "+"))
    print("aaa".replace("aa", "b"))
    print("none".replace("x", "y"))
    print("ab".repeat(3))
    print("ab".repeat(0))
    print("Äpfel".lower())
    print("straße".upper())
    print("ÀÉÎ".lower())
    print("42".parse_int())
    print("+007".parse_int())
    print("-12".parse_int())
    print("4x".parse_int())
    print("".parse_int())
    print("-".parse_int())
    print("99999999999999999999".parse_int())
    print("-9223372036854775808".parse_int())
    print("-1.5e2".parse_f64())
    print("2".parse_f64())
    print("1e400".parse_f64())
    print(".5".parse_f64())
    print("inf".parse_f64())
    print("NaN".parse_f64())
    print('7'.is_digit())
    print('٣'.is_digit())
    print('½'.is_digit())
    print('x'.is_letter())
    print('ä'.is_letter())
    print('1'.is_letter())
    print(' '.is_space())
    print('\u{a0}'.is_space())

    // text values are independent copies
    str a = "x"
    str b = a
    a += "y"
    b += "z"
    print("{a} {b}")
    str long = ""
    for int i in range(200) {
        long += "ab"
    }
    str copy = long
    long += "!"
    print(long.len())
    print(copy.len())
    print(shout("done"))
    str word = "nested"
    print("{1 + 2} {word} {true} {-5}".len())
    print("tab\tquote\"back\\slash\u{1}")
    print(["tab\tquote\"back\\slash\u{1}", "a\{b\}"])
    print('\'')
    print(['\'', '\n', 'x'])
    print("a" < "b")
    print("a" < "")
    print("abc" == "abc")
    print("é" > "z")
}
